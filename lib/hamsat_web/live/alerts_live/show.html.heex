<div class="grid md:grid-cols-[minmax(0,8fr)_minmax(0,3fr)]">
  <%!-- Left column: header, timeline, trackers --%>
  <div class="md:border-r">
    <%!-- Header --%>
    <div class="bg-gray-50 border-b px-3 pt-4 pb-3 md:px-6 md:pt-6 md:pb-5 flex flex-col gap-2">
      <div class="flex items-center gap-3 flex-wrap">
        <h1 class="text-2xl font-medium text-gray-700 whitespace-nowrap">
          <%= @alert.callsign %> on <%= @alert.sat.name %>
        </h1>
        <%= if @alert.match do %>
          <span
            class="bg-emerald-100 text-emerald-600 px-2.5 py-0.5 text-[15px] font-semibold rounded"
            title={match_tooltip(@alert)}
          >
            <%= pct(@alert.match.total) %> match
          </span>
        <% end %>
        <AlertSaver.component
          alert={@alert}
          context={@context}
          id={"alert-saver-#{@alert.id}"}
          class="ml-auto tabular-nums text-sm font-medium text-gray-700"
          button_class="inline-flex items-center rounded bg-gray-200 hover:bg-gray-300 border border-gray-300 px-3 py-1"
        />
      </div>

      <div class="flex flex-wrap gap-x-10 gap-y-3 text-sm">
        <div>
          <div class="uppercase text-[11px] tracking-wider text-gray-400 mb-0.5">When</div>
          <div class="text-gray-700"><%= when_text(@context, @alert) %></div>
        </div>
        <div>
          <div class="uppercase text-[11px] tracking-wider text-gray-400 mb-0.5">Grid</div>
          <div class="text-gray-700"><%= alert_grids(@alert) %></div>
        </div>
        <div>
          <div class="uppercase text-[11px] tracking-wider text-gray-400 mb-0.5">Uplink</div>
          <div class="text-gray-700"><%= uplink_text(@alert) %></div>
        </div>
        <%= if @alert.comment do %>
          <div>
            <div class="uppercase text-[11px] tracking-wider text-gray-400 mb-0.5">Comment</div>
            <div class="text-gray-700 italic">“<%= @alert.comment %>”</div>
          </div>
        <% end %>
      </div>
    </div>

    <%!-- Timeline --%>
    <div class="px-10 pt-5 pb-4 md:pt-7 md:pb-5 flex flex-col md:flex-row gap-10">
      <% {status_label, status_timer, status_class} = @status %>
      <div class="flex flex-col items-center gap-1.5 mr-4">
        <div class={["uppercase tracking-wide px-4 py-1.5 border-2 font-semibold text-sm", status_class]}>
          <%= status_label %>
        </div>
        <div class="text-sm text-gray-500 tabular-nums"><%= status_timer %></div>
      </div>

      <div class="mx-4 flex-grow">
        <div class="relative h-8">
          <%!-- Track --%>
          <div class="absolute left-0 right-0 top-3.5 h-1 bg-gray-200"></div>

          <%= if @alert.is_workable? do %>
            <div class="absolute top-3.5 h-1 bg-emerald-500" style={workable_segment_style(@alert)}></div>
          <% end %>

          <%!-- Rise / set nodes --%>
          <div
            class={["absolute top-1 w-6 h-6 rounded-full bg-white border-4 -ml-3", node_class(@alert, :rise)]}
            style="left: 0%"
          >
          </div>
          <div
            class={["absolute top-1 w-6 h-6 rounded-full bg-white border-4 -ml-3", node_class(@alert, :set)]}
            style="left: 100%"
          >
          </div>

          <%!-- Visible window nodes --%>
          <%= if separate_node?(@alert, :rise) do %>
            <div
              class="absolute top-1 w-6 h-6 rounded-full bg-white border-4 border-emerald-500 -ml-3"
              style={marker_left(@alert, @alert.workable_start_at)}
              title="Visible from both stations"
            >
            </div>
          <% end %>
          <%= if separate_node?(@alert, :set) do %>
            <div
              class="absolute top-1 w-6 h-6 rounded-full bg-white border-4 border-emerald-500 -ml-3"
              style={marker_left(@alert, @alert.workable_end_at)}
            >
            </div>
          <% end %>

          <%!-- Satellite cursor --%>
          <div
            class={[
              @cursor_class,
              "absolute top-px w-[30px] h-[30px] -ml-[15px] rounded-full shadow flex items-center justify-center transition-[left] duration-1000 ease-linear"
            ]}
            style={@cursor_style}
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="#fff" aria-hidden="true">
              <g transform="rotate(45 12 12)">
                <rect x="9.3" y="9.8" width="5.4" height="4.4" rx="0.8"></rect>
                <rect x="2" y="10.4" width="6.2" height="3.2" rx="0.6"></rect>
                <rect x="15.8" y="10.4" width="6.2" height="3.2" rx="0.6"></rect>
              </g>
            </svg>
          </div>
        </div>

        <%!-- Node labels --%>
        <div class="relative h-10 text-[13px] text-gray-500">
          <div class="absolute -translate-x-1/2 text-center pt-1.5 whitespace-nowrap" style="left: 0%">
            <div class={["font-semibold", node_time_class(@alert, :rise)]}>
              <%= short_time(@context, @alert.aos_at) %>
            </div>
            <div><%= node_label(@alert, :rise) %></div>
          </div>
          <%= if separate_node?(@alert, :rise) do %>
            <div
              class="absolute -translate-x-1/2 text-center pt-1.5 whitespace-nowrap"
              style={marker_left(@alert, @alert.workable_start_at)}
            >
              <div class="font-semibold text-emerald-700"><%= short_time(@context, @alert.workable_start_at) %></div>
              <div>Visible</div>
            </div>
          <% end %>
          <%= if separate_node?(@alert, :set) do %>
            <div
              class="absolute -translate-x-1/2 text-center pt-1.5 whitespace-nowrap"
              style={marker_left(@alert, @alert.workable_end_at)}
            >
              <div class="font-semibold text-emerald-700"><%= short_time(@context, @alert.workable_end_at) %></div>
              <div>End visible</div>
            </div>
          <% end %>
          <div class="absolute -translate-x-1/2 text-center pt-1.5 whitespace-nowrap" style="left: 100%">
            <div class={["font-semibold", node_time_class(@alert, :set)]}>
              <%= short_time(@context, @alert.los_at) %>
            </div>
            <div><%= node_label(@alert, :set) %></div>
          </div>
        </div>
      </div>
    </div>

    <%!-- Station trackers --%>
    <%= if @my_sat_position do %>
      <div class="grid lg:grid-cols-2 border-t">
        <.station_tracker
          id="my-pass-tracker"
          title={"My station · #{Grid.encode!(@context.location, 4)}"}
          position={@my_sat_position}
          alert={@alert}
          now={@now}
          pass_plot={Enum.at(@pass_match.plots, 0)}
          class="md:border-r border-b md:border-b-0"
        />
        <.station_tracker
          id="dx-pass-tracker"
          title={"#{@alert.callsign} · #{Grid.encode!(@alert.observer_lat, @alert.observer_lon, 4)}"}
          position={@activator_sat_position}
          alert={@alert}
          now={@now}
          pass_plot={Enum.at(@pass_match.plots, 1)}
        />
      </div>
    <% else %>
      <div class="border-t p-6">
        <div class="md:w-2/3 mx-auto">
          <.location_prompt context={@context} redirect={~p"/alerts/#{@alert.id}"} />
        </div>
      </div>
    <% end %>
  </div>

  <%!-- Right column: aux sidebar --%>
  <div class="bg-gray-50 px-3 py-4 md:px-6 md:py-5 flex flex-col gap-6 text-sm border-t md:border-t-0">
    <%= if Alert.owned?(@alert, @context.user) do %>
      <.link
        navigate={~p"/alerts/#{@alert.id}/edit"}
        class="btn btn-default border-gray-300 w-full justify-center text-center"
      >
        Edit activation
      </.link>
    <% end %>

    <%= if @alert.chat_enabled do %>
      <div class="flex flex-col gap-1.5">
        <div class="flex items-center justify-between">
          <div class="text-[13px] font-semibold uppercase tracking-wider text-gray-400">Chat</div>
          <%= case @chat_status do %>
            <% :open -> %>
              <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-700">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Open
              </span>
            <% :before -> %>
              <span class="text-xs font-semibold text-gray-400 tabular-nums">
                Opens in <%= duration(@now, Chat.opens_at(@alert)) %>
              </span>
            <% _ -> %>
              <span class="text-xs font-semibold text-gray-400">Closed</span>
          <% end %>
        </div>

        <div class="bg-white border rounded overflow-hidden flex flex-col">
          <div class="relative">
            <%= if @chat_empty? do %>
              <div class="absolute inset-0 flex items-center justify-center text-gray-400 italic pointer-events-none">
                No messages yet
              </div>
            <% end %>
            <div
              id="chat-messages"
              phx-update="append"
              phx-hook="ChatMessages"
              class="h-56 overflow-y-auto px-3 py-2 flex flex-col gap-1"
            >
              <%= for message <- @chat_messages do %>
                <div id={"chat-message-#{message.id}"} class="break-words">
                  <span class="text-xs text-gray-400 tabular-nums">
                    <%= short_time(@context, message.inserted_at) %>
                  </span>
                  <span class="font-semibold text-gray-700"><%= ChatMessage.sender_name(message) %>:</span>
                  <span class="text-gray-600"><%= message.body %></span>
                </div>
              <% end %>
            </div>
          </div>

          <div class="border-t px-2 py-2">
            <%= cond do %>
              <% @chat_status == :open and @context.user != :guest -> %>
                <.form
                  :let={f}
                  for={@chat_changeset}
                  as={:chat_message}
                  id="chat-form"
                  phx-submit="send-chat-message"
                  phx-hook="ChatForm"
                  class="flex items-center gap-2"
                >
                  <%= text_input(f, :body,
                    class: "input-text flex-grow text-sm min-w-0",
                    placeholder: "Chat as #{Chat.username(@context.user)}",
                    autocomplete: "off",
                    required: true,
                    maxlength: 200
                  ) %>
                  <%= submit("Send", class: "btn btn-default") %>
                </.form>
                <div class="mt-1.5 text-xs text-gray-400 text-center tabular-nums">
                  Chat closes in <%= chat_closes_in(@alert, @now) %>
                </div>
              <% @chat_status == :open -> %>
                <div class="text-gray-500 text-center py-1">
                  <a href={~p"/users/log_in"} class="link">Log in</a> to join the chat.
                </div>
              <% @chat_status == :before -> %>
                <div class="text-gray-500 text-center py-1">
                  Chat opens 5 minutes before the pass.
                </div>
              <% true -> %>
                <div class="text-gray-500 text-center py-1">Chat has ended.</div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <div class="flex flex-col gap-1.5">
      <div class="text-[13px] font-semibold uppercase tracking-wider text-gray-400">
        Saved by <%= saved_by_count(@saved_by) %>
      </div>
      <% {saved_callsigns, saved_extra} = @saved_by %>
      <div class="text-gray-500 flex flex-wrap gap-x-3 gap-y-1">
        <%= for callsign <- saved_callsigns do %>
          <span><%= callsign %></span>
        <% end %>
        <%= if saved_extra > 0 do %>
          <span>+<%= saved_extra %> more</span>
        <% end %>
        <%= if saved_callsigns == [] and saved_extra == 0 do %>
          <span class="italic">nobody yet</span>
        <% end %>
      </div>
    </div>

    <div class="flex flex-col gap-1.5">
      <div class="text-[13px] font-semibold uppercase tracking-wider text-gray-400">Links</div>
      <a href={satmatch_url(@context, @alert)} class="link font-normal" target="_blank">SatMatch ↗</a>
      <a href={tweet_url(@alert)} class="link font-normal">Share on X</a>
      <a href={mastodon_url(@alert)} class="link font-normal">Share on Mastodon</a>
    </div>

    <%= if @my_sat_position do %>
      <div class="flex flex-col gap-2">
        <div class="bg-gray-800 rounded-lg overflow-hidden min-h-[170px]">
          <SatTracker.component
            id="sat-tracker"
            height="220px"
            sat_positions={[
              %{
                sat_id: @alert.satellite_id,
                sat_name: @alert.sat.name,
                position: @activator_sat_position,
                selected: true
              }
            ]}
            observer_positions={[@context.location, activator_coord(@alert)]}
          />
        </div>
      </div>
    <% end %>

    <%= if @alert.match do %>
      <div class="flex flex-col gap-2">
        <div class="text-[13px] font-semibold uppercase tracking-wider text-gray-400">Match scoring</div>
        <div class="flex justify-between text-gray-500">
          <span>My elevation</span>
          <span class="text-emerald-600 font-semibold"><%= pct(@alert.match.my_el) %></span>
        </div>
        <div class="flex justify-between text-gray-500">
          <span><%= @alert.callsign %> elevation</span>
          <span class="text-emerald-600 font-semibold"><%= pct(@alert.match.dx_el) %></span>
        </div>
        <div class="flex justify-between text-gray-500">
          <span>Mode</span>
          <span class="text-emerald-600 font-semibold"><%= pct(@alert.match.mode) %></span>
        </div>
        <div class="flex justify-between text-gray-700">
          <span class="font-semibold">Combined</span>
          <span class="text-emerald-600 font-semibold"><%= pct(@alert.match.total) %></span>
        </div>
      </div>
    <% end %>
  </div>
</div>
