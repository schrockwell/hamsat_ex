<div>
  <%= if @context.location == nil do %>
    <div class="flex items-center gap-4 bg-amber-50 border-b border-amber-200 px-3 md:px-6 py-3 text-sm text-amber-800">
      <Heroicons.LiveView.icon name="map-pin" type="outline" class="h-5 w-5 shrink-0" />
      <div class="flex-1">
        Welcome to Hamsat! You're seeing passes over <strong><%= @grid_label %></strong>.
        Set your location to see predictions from your QTH.
      </div>
      <button
        class="btn btn-default btn-sm border-gray-300 whitespace-nowrap"
        phx-click="show-location-modal"
        phx-value-redirect="/"
      >
        Set Location
      </button>
    </div>
  <% end %>

  <div class="grid md:grid-cols-[minmax(0,7fr)_minmax(0,4fr)]">
    <div class="p-3 md:p-6 md:border-r">
      <%= if @my_alerts != [] do %>
        <div class="mb-10">
          <div class="flex items-center justify-between mb-1">
            <h1 class="text-2xl font-medium text-gray-700 whitespace-nowrap">My activations</h1>
          </div>

          <div class="text-sm text-gray-500 border-b pb-3">
            <%= length(@my_alerts) %> upcoming
          </div>

          <div class="overflow-x-auto hidden md:block">
            <table class="w-full border-collapse text-sm slashed-zero">
              <%= for alert <- @my_alerts do %>
                <.activation_rows alert={alert} context={@context} now={@now} show_match={false} id_suffix="-mine" />
              <% end %>
            </table>
          </div>

          <div class="md:hidden">
            <%= for alert <- @my_alerts do %>
              <.activation_card alert={alert} context={@context} now={@now} show_match={false} id_suffix="-mine" />
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="flex items-center justify-between mb-1">
        <h1 class="text-2xl font-medium text-gray-700 whitespace-nowrap">Upcoming activations</h1>
        <.link navigate={~p"/alerts"} class="link text-sm">All activations →</.link>
      </div>

      <div class="text-sm text-gray-500 border-b pb-3">
        <%= @visible_count %> visible from <a
          href="#"
          phx-click="show-location-modal"
          phx-value-redirect="/"
          title="Edit your location"
          class="text-gray-500 underline hover:text-gray-700"
          phx-no-format
        ><%= @grid_label %></a> · <%= @not_visible_count %> more not visible
      </div>

      <%= if @visible_alerts == [] do %>
        <div class="my-6 text-gray-400 italic text-center">
          No upcoming activations are visible from <%= @grid_label %>.
        </div>
      <% else %>
        <div class="overflow-x-auto hidden md:block">
          <table class="w-full border-collapse text-sm slashed-zero">
            <%= for alert <- @visible_alerts do %>
              <.activation_rows alert={alert} context={@context} now={@now} />
            <% end %>
          </table>
        </div>

        <div class="md:hidden">
          <%= for alert <- @visible_alerts do %>
            <.activation_card alert={alert} context={@context} now={@now} />
          <% end %>
        </div>
      <% end %>

      <div class="mt-6">
        <button class="text-gray-400 font-medium flex items-center" phx-click="toggle-rss-feed">
          <%= if @show_rss_feed do %>
            <Heroicons.LiveView.icon name="chevron-down" class="h-4 w-4" type="solid" /> RSS Feed
          <% else %>
            <Heroicons.LiveView.icon name="chevron-right" class="h-4 w-4" type="solid" /> RSS Feed
          <% end %>
        </button>
        <%= if @show_rss_feed do %>
          <div class="mt-2">
            <.mono_copy text={upcoming_feed_url(@context)} />
          </div>

          <%= if @context.user == :guest do %>
            <div class="mt-2 text-gray-500 flex items-center gap-1">
              <Heroicons.LiveView.icon name="information-circle" class="inline h-4 w-4" type="outline" />
              This is a generic public feed. Log in to access your personalized feed.
            </div>
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="p-3 md:p-6 bg-gray-50">
      <div class="flex items-baseline justify-between mb-1">
        <h2 class="text-2xl font-medium text-gray-700">Upcoming passes</h2>
        <.link navigate={~p"/passes"} class="link text-sm">All passes →</.link>
      </div>

      <div class="text-sm text-gray-500 pb-3 border-b">Next 6 hours</div>

      <div class="flex flex-col">
        <%= for pass <- @quiet_passes do %>
          <div class="flex items-center justify-between gap-3 py-3 border-b">
            <div>
              <div class="text-sm font-semibold text-gray-700">
                <%= pass_sat_name(pass) %> <SatComponents.sat_modulation_labels sat={pass.sat} />
              </div>
              <div class="text-[13px] text-gray-500">
                <%= short_time(@context, pass.info.aos.datetime) %> – <%= short_time(
                  @context,
                  pass.info.los.datetime
                ) %> · max <%= pass_max_el(pass) %>
              </div>
            </div>
            <.link
              navigate={~p"/alerts/new?pass=#{Pass.encode_hash(pass)}"}
              class="btn btn-green btn-sm border-transparent whitespace-nowrap"
              title="Post an activation for this pass"
            >
              Activate
            </.link>
          </div>
        <% end %>

        <%= if @passes_loading? do %>
          <div class="py-3 text-gray-400 italic">Calculating passes…</div>
        <% end %>

        <%= if not @passes_loading? and @quiet_passes == [] do %>
          <div class="py-3 text-gray-400 italic">No quiet passes in the next 6 hours.</div>
        <% end %>
      </div>
    </div>
  </div>
</div>
