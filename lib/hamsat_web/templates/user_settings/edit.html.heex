<div class="p-3 md:p-6">
  <div class="flex md:flex-row flex-col justify-between items-start">
    <h1 class="text-h2 md:text-h1 md:mb-6">Account Settings</h1>
    <.link href={~p"/users/log_out"} class="text-red-500 hover:text-red-700 font-medium mb-4" , method="delete">
      Log Out
    </.link>
  </div>

  <div class="flex flex-col md:flex-row items-start gap-4 md:gap-6">
    <div class="w-full md:flex-1 flex flex-col gap-4 md:gap-6">
      <%!-- Activation match preferences --%>
      <section class="border border-gray-300 rounded-lg p-4 md:p-6">
        <.form :let={f} for={@match_preferences_changeset} action={~p"/users/settings"} id="update_match_preferences">
          <%= hidden_input(f, :action, name: "action", value: "update_match_preferences") %>

          <p class="text-sm text-gray-500 mb-3">
            At the moment of closest approach between the two stations, prefer that the satellite is above these
            elevations. Below these elevations, the match score is reduced.
          </p>

          <%= for {label, field} <- [{"My Minimum Elevation", :prefer_my_el}, {"DX Minimum Elevation", :prefer_dx_el}] do %>
            <fieldset class="mb-3">
              <label class="block font-medium mb-1"><%= label %></label>
              <div class="flex space-x-4">
                <%= range_input(f, field, required: true, min: 0, max: 90, class: "w-full mt-1") %>
                <div class="w-12 text-right">
                  <span data-value-of-range={"update_match_preferences_#{field}"}>0</span>°
                </div>
              </div>
            </fieldset>
          <% end %>

          <p class="text-sm text-gray-500 mt-6 mb-3">
            Prefer activations with certain modes of operation. The match score is reduced relative to the other mode
            preferences.
          </p>

          <%= for {label, field} <- [{"SSB", :prefer_ssb_mode}, {"CW", :prefer_cw_mode}, {"Data", :prefer_data_mode}, {"FM", :prefer_fm_mode}] do %>
            <fieldset class="mb-3">
              <label class="block font-medium mb-1"><%= label %></label>
              <div class="flex space-x-4">
                <%= range_input(f, field, required: true, min: 0, max: 100, class: "w-full mt-1") %>
                <div class="w-12 text-right">
                  <span data-value-of-range={"update_match_preferences_#{field}"}>0</span>%
                </div>
              </div>
            </fieldset>
          <% end %>

          <div class="mt-4">
            <%= submit("Save Match Preferences", class: "btn btn-default") %>
          </div>
        </.form>
      </section>

      <%!-- API --%>
      <section class="border border-gray-300 rounded-lg p-4 md:p-6">
        <fieldset class="mb-3">
          <label class="block font-medium mb-1">API Key</label>
          <.mono_copy text={@context.user.feed_key} />

          <div class="text-sm text-gray-500 mt-1">
            Authenticates the RSS feed and API calls to adapt to your station location.
          </div>
        </fieldset>

        <fieldset>
          <label class="block font-medium mb-1">Documentation</label>
          <%= link("API Documentation", to: ~p"/api/docs", class: "link") %>

          <div class="text-sm text-gray-500 mt-1">
            Browse the API reference and try requests with your API key.
          </div>
        </fieldset>
      </section>
    </div>

    <div class="w-full md:flex-1 flex flex-col gap-4 md:gap-6">
      <%!-- Notifications --%>
      <section class="border border-gray-300 rounded-lg p-4 md:p-6">
        <label class="flex items-start gap-3 cursor-pointer">
          <input
            type="checkbox"
            id="push-reminders-toggle"
            data-vapid-public-key={Hamsat.Push.WebPush.vapid_public_key()}
            checked={@current_user.push_reminders_enabled}
            class="mt-1"
          />
          <span>
            <span class="font-medium">Activation reminders</span>
            <span class="block text-sm text-gray-500">
              Get a browser notification one minute before an activation you liked begins.
            </span>
            <span id="push-reminders-status" class="block text-sm text-gray-500 mt-1"></span>
          </span>
        </label>

        <div class="mt-4">
          <button type="button" id="push-test-button" class="btn btn-default btn-sm border-gray-300">
            Send Test Notification
          </button>
        </div>
      </section>

      <%!-- Change email --%>
      <section class="border border-gray-300 rounded-lg p-4 md:p-6">
        <.form :let={f} for={@email_changeset} action={~p"/users/settings"} id="update_email">
          <%= if @email_changeset.action do %>
            <div class="text-red-500 my-2 text-sm font-medium">
              <p>Oops, something went wrong! Please check the errors below.</p>
            </div>
          <% end %>

          <%= hidden_input(f, :action, name: "action", value: "update_email") %>

          <fieldset class="mb-3">
            <label class="block font-medium mb-1">Email</label>
            <%= email_input(f, :email, required: true, class: "input-text w-full") %>
            <%= error_tag(f, :email) %>
          </fieldset>

          <fieldset class="mb-3">
            <label class="block font-medium mb-1">Current Password</label>
            <%= password_input(f, :current_password,
              required: true,
              name: "current_password",
              id: "current_password_for_email",
              class: "input-text w-full"
            ) %>
            <%= error_tag(f, :current_password) %>
          </fieldset>

          <div class="mt-4">
            <%= submit("Change Email", class: "btn btn-default") %>
          </div>
        </.form>
      </section>

      <%!-- Change password --%>
      <section class="border border-gray-300 rounded-lg p-4 md:p-6">
        <.form :let={f} for={@password_changeset} action={~p"/users/settings"} id="update_password">
          <%= if @password_changeset.action do %>
            <div class="alert alert-danger">
              <p>Oops, something went wrong! Please check the errors below.</p>
            </div>
          <% end %>

          <%= hidden_input(f, :action, name: "action", value: "update_password") %>

          <fieldset class="mb-3">
            <label class="block font-medium mb-1">New Password</label>
            <%= password_input(f, :password, required: true, class: "input-text w-full") %>
            <%= error_tag(f, :password) %>
            <div class="form-hint"><%= password_requirements() %></div>
          </fieldset>

          <fieldset class="mb-3">
            <label class="block font-medium mb-1">Confirm New Password</label>
            <%= password_input(f, :password_confirmation, required: true, class: "input-text w-full") %>
            <%= error_tag(f, :password_confirmation) %>
          </fieldset>

          <fieldset class="mb-3">
            <label class="block font-medium mb-1">Current Password</label>
            <%= password_input(f, :current_password,
              required: true,
              name: "current_password",
              id: "current_password_for_password",
              class: "input-text w-full"
            ) %>
            <%= error_tag(f, :current_password) %>
          </fieldset>

          <div class="mt-4">
            <%= submit("Change Password", class: "btn btn-default") %>
          </div>
        </.form>
      </section>

      <%!-- Change callsign --%>
      <section class="border border-gray-300 rounded-lg p-4 md:p-6">
        <.form :let={f} for={@callsign_changeset} action={~p"/users/settings"} id="update_callsign">
          <%= if @callsign_changeset.action do %>
            <div class="text-red-500 my-2 text-sm font-medium">
              <p>Oops, something went wrong! Please check the errors below.</p>
            </div>
          <% end %>

          <%= hidden_input(f, :action, name: "action", value: "update_callsign") %>

          <fieldset class="mb-3">
            <label class="block font-medium mb-1">Callsign</label>
            <%= text_input(f, :callsign, class: "input-text w-full uppercase", placeholder: "Optional") %>
            <%= error_tag(f, :callsign) %>
          </fieldset>

          <div class="mt-4">
            <%= submit("Change Callsign", class: "btn btn-default") %>
          </div>
        </.form>
      </section>
    </div>
  </div>
</div>
